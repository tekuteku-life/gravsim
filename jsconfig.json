{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"allowJs": true,
		"checkJs": true,
		"noEmit": true,
		"strict": false,
		"skipLibCheck": true,
		"lib": ["ES2022", "DOM", "DOM.Iterable", "WebWorker"]
	},
	"include": [
		"types/**/*.d.ts",
		"scripts/**/*.js"
	],
	"exclude": [
		"node_modules",
		"coverage"
	]
}
